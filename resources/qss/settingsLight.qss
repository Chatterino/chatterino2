* {
    font-size: 14px;
    font-family: "Segoe UI";
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
}

chatterino--ComboBox {
    width: 120px;
    background-color: #dddddd;
}

QScrollArea {
    border: none;
}

QScrollArea QFrame {
    border: none;
}

QComboBox QFrame {
    border: 1px solid #66BCFF;
}

QWidget#generalSettingsScrollContent {
    background-color: #dddddd;
}

chatterino--SettingsPage QToolTip {
    padding: 2px;
    background-color: #e6e6e6;
    border: 1px solid #545454;
    color: black;
}

chatterino--PageHeader {
    margin-bottom: 12px;
}

chatterino--TitleLabel {
    font-family: "Segoe UI light";
    font-size: 24px;
    color: #00aeef; /* Should this be same as accent color? */
}

chatterino--SubtitleLabel {
    font-family: "Segoe UI light";
    font-size: 16px;
    color: #00aeef; /* Should this be same as accent color? */
}

chatterino--DescriptionLabel {
    color: black;
}

QLabel#description {
    color: #00aeef; /* Should this be same as accent color? */
    padding-left: 10px;
}

chatterino--NavigationLabel {
    font-family: "Segoe UI light";
    font-size: 15px;
    color: #005d81;
}

chatterino--SettingsDialogTab {
    font-family: "Segoe UI";
    font-size: 14;
}

chatterino--SettingsDialogTab#active {
    font-family: "Segoe UI";
    font-size: 14;
    color: #00aeef; /* Should this be same as accent color? */
}

